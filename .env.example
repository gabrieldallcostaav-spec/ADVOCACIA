# Modo prévia.
# true  (padrão): exibe conteúdo demonstrativo identificado e aplica noindex
#                 em todo o site, além de bloquear o rastreamento no robots.txt.
# false:          modo produção. Só vai ao ar o que estiver aprovado.
NEXT_PUBLIC_MODO_PREVIA=true

# Não há integrações com segredos nesta versão: o site não possui formulário,
# analytics, banco de dados nem envio de e-mail. Se o formulário de contato for
# habilitado no futuro, as credenciais do provedor entram aqui — apenas no
# servidor, nunca com o prefixo NEXT_PUBLIC_.
