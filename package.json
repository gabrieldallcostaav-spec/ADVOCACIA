{
  "name": "advocacia-dalla-costa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "EXPORTAR_ESTATICO=true next build && node cloudflare/limpar-rotas-404.mjs && cp cloudflare/_headers out/_headers",
