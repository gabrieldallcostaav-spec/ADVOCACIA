{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Projeto só de arquivos estáticos: não há campo "main", então nenhum
  // código roda por requisição — o Cloudflare serve os arquivos de `out/`.
  "name": "advocacia-dalla-costa",
  "compatibility_date": "2026-10-23",

  "assets": {
    "directory": "./out",

    // Rotas inexistentes devolvem a página 404 do próprio site, com status 404.
    "not_found_handling": "404-page"

    // "html_handling" fica no padrão "auto-trailing-slash": como o build gera
    // `sobre.html`, a URL /sobre responde 200 direto, sem redirecionamento.
  }
}
